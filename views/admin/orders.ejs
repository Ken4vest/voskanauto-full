<%- include('../partials/layout') %>

<div class="filters-row">
<select class="filter-input" onchange="location.href='/admin/orders?status='+this.value">
<option value="all" <%= status === 'all' ? 'selected' : '' %>>Все статусы</option>
<option value="created" <%= status === 'created' ? 'selected' : '' %>>Создан</option>
<option value="in_progress" <%= status === 'in_progress' ? 'selected' : '' %>>В работе</option>
<option value="waiting_parts" <%= status === 'waiting_parts' ? 'selected' : '' %>>Ожидает запчастей</option>
<option value="ready" <%= status === 'ready' ? 'selected' : '' %>>Готов</option>
<option value="completed" <%= status === 'completed' ? 'selected' : '' %>>Выдан</option>
</select>
<input type="text" class="filter-input" placeholder="Поиск по номеру, клиенту...">
<a href="/admin/orders/create" class="btn btn-primary"><i class="fas fa-plus"></i> Новый заказ-наряд</a>
</div>

<div class="card">
<div class="card-header"><div class="card-title">Заказ-наряды</div><div class="card-actions"><button class="btn btn-outline btn-sm"><i class="fas fa-download"></i> Экспорт</button></div></div>
<div class="card-body" style="padding:0">
<table class="data-table">
<thead><tr><th>№</th><th>Дата</th><th>Клиент</th><th>Автомобиль</th><th>Работы</th><th>Исполнитель</th><th>Статус</th><th>Сумма</th><th>Действия</th></tr></thead>
<tbody>
<% orders.forEach(order => { %>
<tr>
<td><a href="/admin/orders/<%= order.id %>" style="color:var(--primary);text-decoration:none;font-weight:600">#<%= order.order_number %></a></td>
<td><%= new Date(order.created_at).toLocaleDateString('ru-RU') %></td>
<td><div class="client-name"><%= order.client_name %></div><div class="client-phone"><%= order.client_phone %></div></td>
<td>
<% if (order.brand) { %>
<div class="car-info"><div class="car-avatar"><i class="fas fa-car"></i></div><div class="car-details"><div class="car-model"><%= order.brand %> <%= order.model %></div><div class="car-plate"><%= order.license_plate %></div></div></div>
<% } else { %>—<% } %>
</td>
<td><%= order.description || '—' %></td>
<td><%= order.mechanic_name || '—' %></td>
<td>
<% if (order.status === 'created') { %><span class="status-badge status-created">Создан</span>
<% } else if (order.status === 'in_progress') { %><span class="status-badge status-work">В работе</span>
<% } else if (order.status === 'waiting_parts') { %><span class="status-badge status-wait">Ожидает запчастей</span>
<% } else if (order.status === 'ready') { %><span class="status-badge status-ready">Готов</span>
<% } else if (order.status === 'completed') { %><span class="status-badge status-done">Выдан</span>
<% } else { %><span class="status-badge status-cancel">Отменён</span><% } %>
</td>
<td><span class="amount">₽<%= order.total_amount.toLocaleString() %></span></td>
<td>
<a href="/admin/orders/<%= order.id %>" class="btn btn-outline btn-sm"><i class="fas fa-eye"></i></a>
<% if (order.status === 'ready') { %>
<% if (order.status === 'ready') { %>
<button class="btn btn-success btn-sm send-order-btn" data-order-id="<%= order.id %>"><i class="fas fa-paper-plane"></i></button>
<% } %>
<% } %>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>

<script>
function sendOrder(id){
  if(!confirm('Отправить заказ-наряд клиенту?')) return;
  fetch('/admin/orders/'+id+'/send',{method:'POST'})
    .then(r=>r.json())
    .then(data=>{alert(data.message);location.reload();})
    .catch(e=>alert('Ошибка: '+e));
}
</script>

</div>
</main>
</div>
<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('active');
}
</script>
</body>
</html>
