<%- include('../partials/layout') %>

<div class="stats-grid">
<div class="stat-card">
<div class="stat-header"><div class="stat-label">Выручка сегодня</div><div class="stat-icon blue"><i class="fas fa-ruble-sign"></i></div></div>
<div class="stat-value">₽<%= stats.revenueToday.toLocaleString() %></div>
<div class="stat-change up"><i class="fas fa-arrow-up"></i> +12.5%</div>
</div>
<div class="stat-card">
<div class="stat-header"><div class="stat-label">Активные заказ-наряды</div><div class="stat-icon green"><i class="fas fa-wrench"></i></div></div>
<div class="stat-value"><%= stats.activeOrders %></div>
<div class="stat-change up"><i class="fas fa-arrow-up"></i> +2 с утра</div>
</div>
<div class="stat-card">
<div class="stat-header"><div class="stat-label">Загрузка постов</div><div class="stat-icon orange"><i class="fas fa-percentage"></i></div></div>
<div class="stat-value"><%= Math.round((stats.postLoad / 4) * 100) %>%</div>
<div class="stat-change down"><i class="fas fa-arrow-down"></i> -5%</div>
</div>
<div class="stat-card">
<div class="stat-header"><div class="stat-label">Ожидают запчастей</div><div class="stat-icon red"><i class="fas fa-exclamation-triangle"></i></div></div>
<div class="stat-value"><%= stats.waitingParts %></div>
<div class="stat-change up" style="color:var(--danger)"><i class="fas fa-arrow-up"></i> Требует внимания</div>
</div>
</div>

<div class="quick-actions">
<div class="quick-action" onclick="location.href='/admin/orders/create'"><i class="fas fa-plus-circle"></i><span>Новый заказ-наряд</span></div>
<div class="quick-action" onclick="location.href='/admin/clients'"><i class="fas fa-user-plus"></i><span>Новый клиент</span></div>
<div class="quick-action" onclick="location.href='/admin/warehouse'"><i class="fas fa-box-open"></i><span>Приход на склад</span></div>
<div class="quick-action" onclick="location.href='/admin/appointments'"><i class="fas fa-calendar-plus"></i><span>Подтвердить запись</span></div>
</div>

<div class="cards-grid">
<div class="card">
<div class="card-header"><div class="card-title"><i class="fas fa-clipboard-list" style="color:var(--primary);margin-right:8px"></i>Последние заказ-наряды</div><div class="card-actions"><a href="/admin/orders" class="btn btn-outline btn-sm">Все</a></div></div>
<div class="card-body" style="padding:0">
<table class="data-table">
<thead><tr><th>№</th><th>Клиент</th><th>Автомобиль</th><th>Статус</th><th>Сумма</th></tr></thead>
<tbody>
<% recentOrders.forEach(order => { %>
<tr>
<td><a href="/admin/orders/<%= order.id %>" style="color:var(--primary);text-decoration:none;font-weight:600">#<%= order.order_number %></a></td>
<td><div class="client-name"><%= order.client_name %></div></td>
<td>
<% if (order.brand) { %>
<div class="car-info"><div class="car-avatar"><i class="fas fa-car"></i></div><div class="car-details"><div class="car-model"><%= order.brand %> <%= order.model %></div><div class="car-plate"><%= order.license_plate %></div></div></div>
<% } else { %>—<% } %>
</td>
<td>
<% if (order.status === 'created') { %><span class="status-badge status-created">Создан</span>
<% } else if (order.status === 'in_progress') { %><span class="status-badge status-work">В работе</span>
<% } else if (order.status === 'waiting_parts') { %><span class="status-badge status-wait">Ожидает запчастей</span>
<% } else if (order.status === 'ready') { %><span class="status-badge status-ready">Готов</span>
<% } else if (order.status === 'completed') { %><span class="status-badge status-done">Выдан</span>
<% } else { %><span class="status-badge status-cancel">Отменён</span><% } %>
</td>
<td><span class="amount">₽<%= order.total_amount.toLocaleString() %></span></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>

<div class="card">
<div class="card-header"><div class="card-title"><i class="fas fa-exclamation-triangle" style="color:var(--danger);margin-right:8px"></i>Критические остатки</div><div class="card-actions"><a href="/admin/warehouse" class="btn btn-outline btn-sm">Склад</a></div></div>
<div class="card-body" style="padding:0">
<table class="data-table">
<thead><tr><th>Артикул</th><th>Наименование</th><th>Остаток</th><th>Мин.</th><th>Действия</th></tr></thead>
<tbody>
<% criticalParts.forEach(part => { %>
<tr>
<td><strong><%= part.article %></strong></td>
<td><%= part.name %></td>
<td><span style="color:var(--danger);font-weight:700"><%= part.stock_main %> шт.</span></td>
<td><%= part.min_stock %> шт.</td>
<td><form method="POST" action="/admin/warehouse/parts/<%= part.id %>/restock" style="display:inline"><input type="hidden" name="quantity" value="<%= part.min_stock * 2 %>"><button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-shopping-cart"></i> Заказать</button></form></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>

<div class="card" style="margin-top:20px">
<div class="card-header"><div class="card-title"><i class="fas fa-chart-bar" style="color:var(--success);margin-right:8px"></i>Выручка за последние 7 дней</div></div>
<div class="card-body">
<div class="chart-bar">
<div class="chart-bar-item" style="height:45%"><span class="chart-bar-value">₽62K</span><span class="chart-bar-label">Пн</span></div>
<div class="chart-bar-item" style="height:60%"><span class="chart-bar-value">₽78K</span><span class="chart-bar-label">Вт</span></div>
<div class="chart-bar-item" style="height:35%"><span class="chart-bar-value">₽51K</span><span class="chart-bar-label">Ср</span></div>
<div class="chart-bar-item" style="height:80%"><span class="chart-bar-value">₽95K</span><span class="chart-bar-label">Чт</span></div>
<div class="chart-bar-item" style="height:70%"><span class="chart-bar-value">₽84K</span><span class="chart-bar-label">Пт</span></div>
<div class="chart-bar-item" style="height:55%"><span class="chart-bar-value">₽71K</span><span class="chart-bar-label">Сб</span></div>
<div class="chart-bar-item" style="height:30%"><span class="chart-bar-value">₽43K</span><span class="chart-bar-label">Вс</span></div>
</div>
</div>
</div>

</div>
</main>
</div>
<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('active');
}
</script>
</body>
</html>
