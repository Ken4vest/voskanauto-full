<div class="page-header">
  <h1><i class="fas fa-chart-line"></i> Дашборд</h1>
  <div style="display:flex;gap:12px">
    <button class="btn btn-outline" onclick="location.reload()"><i class="fas fa-sync-alt"></i> Обновить</button>
    <a href="/admin/orders/create" class="btn btn-primary"><i class="fas fa-plus"></i> Новый заказ</a>
  </div>
</div>

<!-- БЫСТРЫЕ ДЕЙСТВИЯ -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px">
  <a href="/admin/orders/create" style="background:var(--white);border:1px solid var(--gray-border);border-radius:var(--radius);padding:16px;text-align:center;text-decoration:none;color:var(--dark);transition:all .2s">
    <i class="fas fa-plus-circle" style="font-size:24px;color:var(--primary);margin-bottom:8px;display:block"></i>
    <span style="font-size:12px;font-weight:500">Новый заказ</span>
  </a>
  <a href="/admin/clients" style="background:var(--white);border:1px solid var(--gray-border);border-radius:var(--radius);padding:16px;text-align:center;text-decoration:none;color:var(--dark);transition:all .2s">
    <i class="fas fa-user-plus" style="font-size:24px;color:var(--success);margin-bottom:8px;display:block"></i>
    <span style="font-size:12px;font-weight:500">Новый клиент</span>
  </a>
  <a href="/admin/warehouse" style="background:var(--white);border:1px solid var(--gray-border);border-radius:var(--radius);padding:16px;text-align:center;text-decoration:none;color:var(--dark);transition:all .2s">
    <i class="fas fa-box-open" style="font-size:24px;color:var(--secondary);margin-bottom:8px;display:block"></i>
    <span style="font-size:12px;font-weight:500">Пополнить склад</span>
  </a>
  <a href="/admin/invoices" style="background:var(--white);border:1px solid var(--gray-border);border-radius:var(--radius);padding:16px;text-align:center;text-decoration:none;color:var(--dark);transition:all .2s">
    <i class="fas fa-file-invoice-dollar" style="font-size:24px;color:var(--danger);margin-bottom:8px;display:block"></i>
    <span style="font-size:12px;font-weight:500">Выставить счёт</span>
  </a>
</div>

<!-- KPI СТАТИСТИКА -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-header">
      <div class="stat-label">Заказов сегодня</div>
      <div class="stat-icon blue"><i class="fas fa-clipboard-list"></i></div>
    </div>
    <div class="stat-value"><%= stats.orders %></div>
    <div class="stat-change up"><i class="fas fa-arrow-up"></i> +12% к вчерашнему дню</div>
  </div>
  <div class="stat-card">
    <div class="stat-header">
      <div class="stat-label">Выручка (мес)</div>
      <div class="stat-icon green"><i class="fas fa-ruble-sign"></i></div>
    </div>
    <div class="stat-value">₽<%= (stats.revenue || 0).toLocaleString() %></div>
    <div class="stat-change up"><i class="fas fa-arrow-up"></i> +8% к прошлому месяцу</div>
  </div>
  <div class="stat-card">
    <div class="stat-header">
      <div class="stat-label">Активных клиентов</div>
      <div class="stat-icon orange"><i class="fas fa-users"></i></div>
    </div>
    <div class="stat-value"><%= stats.clients %></div>
    <div class="stat-change up"><i class="fas fa-arrow-up"></i> +3 новых</div>
  </div>
  <div class="stat-card">
    <div class="stat-header">
      <div class="stat-label">Критичных остатков</div>
      <div class="stat-icon red"><i class="fas fa-exclamation-triangle"></i></div>
    </div>
    <div class="stat-value" style="color:var(--danger)"><%= stats.critical %></div>
    <div class="stat-change down" style="color:var(--danger)"><i class="fas fa-arrow-down"></i> Требуют внимания</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px">
  <!-- ПОСЛЕДНИЕ ЗАКАЗЫ -->
  <div class="card">
    <div class="card-header">
      <div class="card-title"><i class="fas fa-clock" style="color:var(--primary);margin-right:8px"></i>Последние заказ-наряды</div>
      <a href="/admin/orders" class="btn btn-outline btn-sm">Все заказы</a>
    </div>
    <div class="card-body" style="padding:0">
      <table class="data-table">
        <thead>
          <tr><th>№</th><th>Дата</th><th>Клиент</th><th>Авто</th><th>Статус</th><th>Сумма</th><th></th></tr>
        </thead>
        <tbody>
          <% if (recentOrders && recentOrders.length > 0) { %>
            <% recentOrders.slice(0, 5).forEach(order => { %>
            <tr>
              <td><a href="/admin/orders/<%= order.id %>" style="color:var(--primary);text-decoration:none;font-weight:600">#<%= order.order_number %></a></td>
              <td><%= order.created_at ? new Date(order.created_at).toLocaleDateString('ru-RU') : '—' %></td>
              <td>
                <div style="font-weight:500"><%= order.client_name || '—' %></div>
              </td>
              <td><%= order.brand ? order.brand + ' ' + order.model : '—' %></td>
              <td>
                <% if (order.status === 'created') { %><span class="status-badge status-created">Создан</span>
                <% } else if (order.status === 'in_progress') { %><span class="status-badge status-work">В работе</span>
                <% } else if (order.status === 'ready') { %><span class="status-badge status-ready">Готов</span>
                <% } else if (order.status === 'completed') { %><span class="status-badge status-done">Выдан</span>
                <% } else { %><span class="status-badge status-cancel">Отменён</span><% } %>
              </td>
              <td><strong>₽<%= (order.total_amount || 0).toLocaleString() %></strong></td>
              <td>
                <a href="/admin/orders/<%= order.id %>" class="btn btn-outline btn-sm"><i class="fas fa-eye"></i></a>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="7" style="text-align:center;padding:24px;color:var(--gray)">Нет заказов</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ПРАВАЯ КОЛОНКА -->
  <div>
    <!-- КРИТИЧЕСКИЕ ОСТАТКИ -->
    <div class="card" style="margin-bottom:20px">
      <div class="card-header">
        <div class="card-title"><i class="fas fa-exclamation-triangle" style="color:var(--danger);margin-right:8px"></i>Критичные остатки</div>
        <a href="/admin/warehouse" class="btn btn-outline btn-sm" style="color:var(--danger);border-color:var(--danger)">Склад</a>
      </div>
      <div class="card-body" style="padding:0">
        <table class="data-table">
          <tbody>
            <% if (criticalParts && criticalParts.length > 0) { %>
              <% criticalParts.slice(0, 5).forEach(part => { %>
              <tr>
                <td><strong><%= part.article %></strong></td>
                <td><%= part.name %></td>
                <td><span style="color:var(--danger);font-weight:700"><%= part.stock_main %> шт.</span></td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="3" style="text-align:center;padding:16px;color:var(--gray);font-size:13px"><i class="fas fa-check-circle" style="color:var(--success);margin-right:4px"></i>Все запчасти в наличии</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- БЛИЖАЙШИЕ ЗАПИСИ -->
    <div class="card">
      <div class="card-header">
        <div class="card-title"><i class="fas fa-calendar-check" style="color:var(--success);margin-right:8px"></i>Ближайшие записи</div>
        <a href="/admin/appointments" class="btn btn-outline btn-sm">Все</a>
      </div>
      <div class="card-body">
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;align-items:center;gap:12px;padding:12px;background:var(--gray-light);border-radius:var(--radius-sm)">
            <div style="width:40px;height:40px;border-radius:50%;background:var(--primary-light);display:flex;align-items:center;justify-content:center;color:var(--primary);font-weight:600;font-size:14px">10:00</div>
            <div style="flex:1">
              <div style="font-weight:500;font-size:13px">ТО Toyota Camry</div>
              <div style="font-size:12px;color:var(--gray)">Даниил Боглюков</div>
            </div>
            <span class="status-badge status-wait">Ожидает</span>
          </div>
          <div style="display:flex;align-items:center;gap:12px;padding:12px;background:var(--gray-light);border-radius:var(--radius-sm)">
            <div style="width:40px;height:40px;border-radius:50%;background:var(--primary-light);display:flex;align-items:center;justify-content:center;color:var(--primary);font-weight:600;font-size:14px">14:30</div>
            <div style="flex:1">
              <div style="font-weight:500;font-size:13px">Диагностика ходовой</div>
              <div style="font-size:12px;color:var(--gray)">Иванов И.П.</div>
            </div>
            <span class="status-badge status-wait">Ожидает</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ГРАФИК ЗАГРУЖЕННОСТИ ПОСТОВ -->
<div class="card" style="margin-top:20px">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-chart-bar" style="color:var(--primary);margin-right:8px"></i>Загруженность постов</div>
  </div>
  <div class="card-body">
    <div style="display:flex;gap:16px;align-items:flex-end;height:120px;padding:16px 0">
      <div style="flex:1;text-align:center">
        <div style="height:80px;background:var(--success);border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600">Свободен</div>
        <div style="font-size:12px;color:var(--gray);margin-top:8px">Пост 1</div>
      </div>
      <div style="flex:1;text-align:center">
        <div style="height:100px;background:var(--secondary);border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600">Занят</div>
        <div style="font-size:12px;color:var(--gray);margin-top:8px">Пост 2</div>
      </div>
      <div style="flex:1;text-align:center">
        <div style="height:60px;background:var(--success);border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600">Свободен</div>
        <div style="font-size:12px;color:var(--gray);margin-top:8px">Пост 3</div>
      </div>
      <div style="flex:1;text-align:center">
        <div style="height:100px;background:var(--danger);border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600">Перегружен</div>
        <div style="font-size:12px;color:var(--gray);margin-top:8px">Пост 4</div>
      </div>
    </div>
  </div>
</div>
