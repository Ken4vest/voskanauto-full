<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-header">
      <div class="stat-label">Общая выручка</div>
      <div class="stat-icon blue"><i class="fas fa-ruble-sign"></i></div>
    </div>
    <div class="stat-value">₽<%= (totalRevenue && totalRevenue.total ? totalRevenue.total : 0).toLocaleString() %></div>
  </div>
  <div class="stat-card">
    <div class="stat-header">
      <div class="stat-label">Выручка сегодня</div>
      <div class="stat-icon green"><i class="fas fa-money-bill-wave"></i></div>
    </div>
    <div class="stat-value">₽<%= (todayRevenue && todayRevenue.total ? todayRevenue.total : 0).toLocaleString() %></div>
  </div>
</div>

<div class="card">
  <div class="card-header"><div class="card-title">Кассовые операции</div></div>
  <div class="card-body" style="padding:0">
    <table class="data-table">
      <thead><tr><th>Дата</th><th>Клиент</th><th>Заказ</th><th>Сумма</th><th>Способ</th></tr></thead>
      <tbody>
        <% if (payments && payments.length > 0) { %>
          <% payments.forEach(p => { %>
          <tr>
            <td><%= p.created_at ? new Date(p.created_at).toLocaleString('ru-RU') : '—' %></td>
            <td><%= p.client_name || '—' %></td>
            <td><%= p.order_number || '—' %></td>
            <td><span class="amount" style="color:var(--success)">+₽<%= (p.amount || 0).toLocaleString() %></span></td>
            <td>
              <% if (p.payment_method === 'cash') { %>Наличные
              <% } else if (p.payment_method === 'online') { %>Онлайн
              <% } else if (p.payment_method === 'qr') { %>QR
              <% } else { %><%= p.payment_method || '—' %><% } %>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align:center;padding:24px;color:var(--gray)">
              <i class="fas fa-inbox" style="font-size:24px;margin-bottom:8px;display:block"></i>
              Нет платежей
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>