<div class="page-header">
  <h1><i class="fas fa-tools"></i> Управление услугами</h1>
  <button class="btn btn-primary" onclick="window.openCreateModal()">
    <i class="fas fa-plus"></i> Новая услуга
  </button>
</div>

<!-- ФИЛЬТРЫ -->
<div class="card" style="margin-bottom:20px;">
  <div class="card-body" style="padding:16px 20px;">
    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
      <div style="flex:1; min-width:200px;">
        <input type="text" id="adminSearchInput" placeholder="Поиск по коду или названию..." 
          onkeyup="window.filterAdminServices()"
          style="width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
      </div>
      <div style="min-width:200px;">
        <select id="adminCategoryFilter" onchange="window.filterAdminServices()"
          style="width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; background:#fff;">
          <option value="all">Все категории</option>
          <option value="ТО">ТО</option>
          <option value="Тормозная система">Тормозная система</option>
          <option value="Ходовая часть">Ходовая часть</option>
          <option value="Двигатель">Двигатель</option>
          <option value="Электрика">Электрика</option>
          <option value="Диагностика">Диагностика</option>
          <option value="Трансмиссия">Трансмиссия</option>
          <option value="Кондиционер">Кондиционер</option>
          <option value="Выхлопная система">Выхлопная система</option>
          <option value="Оптика">Оптика</option>
          <option value="Стёкла">Стёкла</option>
          <option value="Рулевое управление">Рулевое управление</option>
          <option value="Антикор">Антикор</option>
          <option value="Топливная система">Топливная система</option>
          <option value="Шиномонтаж">Шиномонтаж</option>
          <option value="Автомойки">Автомойки</option>
          <option value="Кузовной ремонт">Кузовной ремонт</option>
          <option value="Инфо">Инфо</option>
        </select>
      </div>
      <div style="min-width:140px;">
        <button type="button" class="btn btn-outline" onclick="window.resetAdminFilters()" style="width:100%;">
          <i class="fas fa-undo"></i> Сбросить
        </button>
      </div>
      <div style="min-width:120px; text-align:right;">
        <span id="servicesCount" style="font-size:13px; color:#6b7280;">Всего: <%= services.length %></span>
      </div>
    </div>
  </div>
</div>

<!-- АКТИВНЫЕ УСЛУГИ -->
<div class="card">
  <div class="card-header">
    <h3>Активные услуги</h3>
    <span class="badge" id="activeBadge"><%= services.length %></span>
  </div>
  <div class="table-responsive">
    <table class="data-table" id="servicesTable">
      <thead>
        <tr>
          <th>Код</th>
          <th>Название</th>
          <th>Категория</th>
          <th>Нормо-час</th>
          <th>Ставка</th>
          <th>Цена</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% services.forEach(function(service) { %>
        <tr class="service-row" data-category="<%= service.category %>" data-code="<%= service.code %>" data-name="<%= service.name %>">
          <td><code><%= service.code %></code></td>
          <td>
            <div style="font-weight:500;"><%= service.name %></div>
            <div style="font-size:12px;color:var(--gray);"><%= service.description ? service.description.substring(0, 60) + '...' : '—' %></div>
          </td>
          <td><span class="badge badge-info"><%= service.category %></span></td>
          <td><%= service.labor_hours %></td>
          <td>₽<%= (service.hourly_rate || 0).toLocaleString() %></td>
          <td style="font-weight:600;">₽<%= ((service.labor_hours || 0) * (service.hourly_rate || 0)).toLocaleString() %></td>
          <td>
            <div class="action-btns">
              <button type="button" class="btn btn-sm btn-outline" 
                onclick="window.openEditModal(this)"
                data-id="<%= service.id %>"
                data-code="<%= service.code %>"
                data-name="<%= service.name %>"
                data-category="<%= service.category %>"
                data-description="<%= (service.description || '').replace(/"/g, '&quot;') %>"
                data-labor-hours="<%= service.labor_hours %>"
                data-hourly-rate="<%= service.hourly_rate %>"
                data-compatible-brands="<%= (service.compatible_brands || '').replace(/"/g, '&quot;') %>"
                title="Редактировать">
                <i class="fas fa-edit"></i>
              </button>
              <form method="POST" action="/admin/services/<%= service.id %>/delete" style="display:inline;" onsubmit="return confirm('Удалить услугу <%= service.name %>?')">
                <button type="submit" class="btn btn-sm btn-danger" title="Удалить">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <div id="noResults" style="display:none; padding:40px; text-align:center; color:#6b7280;">
      <i class="fas fa-search" style="font-size:32px; margin-bottom:12px; display:block;"></i>
      <p>Услуги не найдены</p>
    </div>
  </div>
</div>

<!-- НЕАКТИВНЫЕ УСЛУГИ -->
<% if (inactive && inactive.length > 0) { %>
<div class="card" style="margin-top:24px;">
  <div class="card-header">
    <h3>Неактивные услуги</h3>
    <span class="badge badge-warning"><%= inactive.length %></span>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Код</th>
          <th>Название</th>
          <th>Категория</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% inactive.forEach(function(service) { %>
        <tr style="opacity:0.6;">
          <td><code><%= service.code %></code></td>
          <td><%= service.name %></td>
          <td><span class="badge"><%= service.category %></span></td>
          <td>
            <form method="POST" action="/admin/services/<%= service.id %>/restore" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-success">
                <i class="fas fa-undo"></i> Восстановить
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- МОДАЛКА: СОЗДАНИЕ -->
<div id="createModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:9999; justify-content:center; align-items:center;">
  <div style="background:#fff; border-radius:12px; max-width:600px; width:90%; max-height:90vh; overflow-y:auto; padding:24px; position:relative; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
      <h3 style="margin:0; font-size:20px;">Новая услуга</h3>
      <button type="button" onclick="window.closeModal('createModal')" style="background:none; border:none; font-size:28px; cursor:pointer; color:#6b7280; line-height:1;">&times;</button>
    </div>
    <form method="POST" action="/admin/services">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Код <span style="color:#ef4444;">*</span></label>
          <input type="text" name="code" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" placeholder="Напр. ENG-001" required>
        </div>
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Название <span style="color:#ef4444;">*</span></label>
          <input type="text" name="name" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" placeholder="Название работы" required>
        </div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Категория <span style="color:#ef4444;">*</span></label>
          <select name="category" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; background:#fff;" required>
            <option value="">— Выберите —</option>
            <option value="ТО">ТО</option>
            <option value="Тормозная система">Тормозная система</option>
            <option value="Ходовая часть">Ходовая часть</option>
            <option value="Двигатель">Двигатель</option>
            <option value="Электрика">Электрика</option>
            <option value="Диагностика">Диагностика</option>
            <option value="Трансмиссия">Трансмиссия</option>
            <option value="Кондиционер">Кондиционер</option>
            <option value="Выхлопная система">Выхлопная система</option>
            <option value="Оптика">Оптика</option>
            <option value="Стёкла">Стёкла</option>
            <option value="Рулевое управление">Рулевое управление</option>
            <option value="Антикор">Антикор</option>
            <option value="Топливная система">Топливная система</option>
            <option value="Шиномонтаж">Шиномонтаж</option>
            <option value="Автомойки">Автомойки</option>
            <option value="Кузовной ремонт">Кузовной ремонт</option>
            <option value="Инфо">Инфо</option>
          </select>
        </div>
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Нормо-час <span style="color:#ef4444;">*</span></label>
          <input type="number" step="0.1" name="labor_hours" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" placeholder="1.0" required>
        </div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Ставка н/ч (₽)</label>
          <input type="number" name="hourly_rate" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" value="2500">
        </div>
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Совместимость</label>
          <input type="text" name="compatible_brands" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" placeholder="Все марки">
        </div>
      </div>
      <div style="margin-bottom:20px;">
        <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Описание</label>
        <textarea name="description" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; resize:vertical;" rows="3" placeholder="Описание работы..."></textarea>
      </div>
      <div style="display:flex; gap:10px; justify-content:flex-end;">
        <button type="button" class="btn btn-outline" onclick="window.closeModal('createModal')">Отмена</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Сохранить</button>
      </div>
    </form>
  </div>
</div>

<!-- МОДАЛКА: РЕДАКТИРОВАНИЕ -->
<div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:9999; justify-content:center; align-items:center;">
  <div style="background:#fff; border-radius:12px; max-width:600px; width:90%; max-height:90vh; overflow-y:auto; padding:24px; position:relative; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
      <h3 style="margin:0; font-size:20px;">Редактирование услуги</h3>
      <button type="button" onclick="window.closeModal('editModal')" style="background:none; border:none; font-size:28px; cursor:pointer; color:#6b7280; line-height:1;">&times;</button>
    </div>
    <form method="POST" action="" id="editForm">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Код <span style="color:#ef4444;">*</span></label>
          <input type="text" name="code" id="editCode" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" required>
        </div>
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Название <span style="color:#ef4444;">*</span></label>
          <input type="text" name="name" id="editName" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" required>
        </div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Категория <span style="color:#ef4444;">*</span></label>
          <select name="category" id="editCategory" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; background:#fff;" required>
            <option value="">— Выберите —</option>
            <option value="ТО">ТО</option>
            <option value="Тормозная система">Тормозная система</option>
            <option value="Ходовая часть">Ходовая часть</option>
            <option value="Двигатель">Двигатель</option>
            <option value="Электрика">Электрика</option>
            <option value="Диагностика">Диагностика</option>
            <option value="Трансмиссия">Трансмиссия</option>
            <option value="Кондиционер">Кондиционер</option>
            <option value="Выхлопная система">Выхлопная система</option>
            <option value="Оптика">Оптика</option>
            <option value="Стёкла">Стёкла</option>
            <option value="Рулевое управление">Рулевое управление</option>
            <option value="Антикор">Антикор</option>
            <option value="Топливная система">Топливная система</option>
            <option value="Шиномонтаж">Шиномонтаж</option>
            <option value="Автомойки">Автомойки</option>
            <option value="Кузовной ремонт">Кузовной ремонт</option>
            <option value="Инфо">Инфо</option>
          </select>
        </div>
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Нормо-час <span style="color:#ef4444;">*</span></label>
          <input type="number" step="0.1" name="labor_hours" id="editLaborHours" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" required>
        </div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Ставка н/ч (₽)</label>
          <input type="number" name="hourly_rate" id="editHourlyRate" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
        </div>
        <div>
          <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Совместимость</label>
          <input type="text" name="compatible_brands" id="editCompatibleBrands" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;" placeholder="Все марки">
        </div>
      </div>
      <div style="margin-bottom:20px;">
        <label style="display:block; font-size:13px; font-weight:500; margin-bottom:6px; color:#374151;">Описание</label>
        <textarea name="description" id="editDescription" style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; resize:vertical;" rows="3"></textarea>
      </div>
      <div style="display:flex; gap:10px; justify-content:flex-end;">
        <button type="button" class="btn btn-outline" onclick="window.closeModal('editModal')">Отмена</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Сохранить изменения</button>
      </div>
    </form>
  </div>
</div>

<script>
window.openCreateModal = function() {
  var m = document.getElementById('createModal');
  if (m) { m.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
};

window.closeModal = function(id) {
  var m = document.getElementById(id);
  if (m) { m.style.display = 'none'; document.body.style.overflow = ''; }
};

window.openEditModal = function(btn) {
  var id = btn.getAttribute('data-id');
  document.getElementById('editCode').value = btn.getAttribute('data-code');
  document.getElementById('editName').value = btn.getAttribute('data-name');
  document.getElementById('editCategory').value = btn.getAttribute('data-category');
  document.getElementById('editLaborHours').value = btn.getAttribute('data-labor-hours');
  document.getElementById('editHourlyRate').value = btn.getAttribute('data-hourly-rate');
  document.getElementById('editCompatibleBrands').value = btn.getAttribute('data-compatible-brands');
  document.getElementById('editDescription').value = btn.getAttribute('data-description');
  document.getElementById('editForm').action = '/admin/services/' + id;
  window.openModal('editModal');
};

window.openModal = function(id) {
  var m = document.getElementById(id);
  if (m) { m.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
};

window.filterAdminServices = function() {
  var query = document.getElementById('adminSearchInput').value.toLowerCase().trim();
  var category = document.getElementById('adminCategoryFilter').value;
  var rows = document.querySelectorAll('.service-row');
  var visibleCount = 0;

  rows.forEach(function(row) {
    var code = row.getAttribute('data-code').toLowerCase();
    var name = row.getAttribute('data-name').toLowerCase();
    var rowCategory = row.getAttribute('data-category');

    var matchesSearch = !query || code.includes(query) || name.includes(query);
    var matchesCategory = category === 'all' || rowCategory === category;

    if (matchesSearch && matchesCategory) {
      row.style.display = '';
      visibleCount++;
    } else {
      row.style.display = 'none';
    }
  });

  document.getElementById('servicesCount').textContent = 'Показано: ' + visibleCount + ' из ' + rows.length;
  document.getElementById('activeBadge').textContent = visibleCount;

  var noResults = document.getElementById('noResults');
  var table = document.getElementById('servicesTable');
  if (visibleCount === 0) {
    noResults.style.display = 'block';
    table.style.display = 'none';
  } else {
    noResults.style.display = 'none';
    table.style.display = '';
  }
};

window.resetAdminFilters = function() {
  document.getElementById('adminSearchInput').value = '';
  document.getElementById('adminCategoryFilter').value = 'all';
  window.filterAdminServices();
};

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    window.closeModal('createModal');
    window.closeModal('editModal');
  }
});
</script>
