<%- include('../partials/layout') %>

<div class="filters-row">
<h2 style="font-size:20px;font-weight:700"><i class="fas fa-bell" style="color:var(--primary);margin-right:8px"></i>Уведомления</h2>
</div>

<div class="card">
<div class="card-body">
<% if (notifications.length > 0) { %>
<div class="activity-list">
<% notifications.forEach(notif => { %>
  <%
    let bgColor, textColor, iconClass;
    if (notif.type === 'order') {
      bgColor = '#dbeafe';
      textColor = '#1e40af';
      iconClass = 'clipboard-list';
    } else if (notif.type === 'invoice') {
      bgColor = '#fef3c7';
      textColor = '#92400e';
      iconClass = 'file-invoice';
    } else {
      bgColor = '#f3e8ff';
      textColor = '#7c3aed';
      iconClass = 'bell';
    }
  %>
<div class="activity-item">
<div class="activity-icon" data-bg="<%= bgColor %>" data-color="<%= textColor %>">
<i class="fas fa-<%= iconClass %>"></i>
</div>
<div class="activity-content">
<div class="activity-text"><strong><%= notif.title %></strong></div>
<div class="activity-text"><%= notif.message %></div>
<div class="activity-time"><%= new Date(notif.created_at).toLocaleString('ru-RU') %></div>
</div>
</div>
<% }) %>
</div>
<% } else { %>
<div class="empty-state"><i class="fas fa-bell"></i><h3>Нет уведомлений</h3></div>
<% } %>
</div>
</div>

</div>
</main>
</div>
<script>
document.querySelectorAll('.activity-icon[data-bg]').forEach(el => {
  el.style.background = el.dataset.bg;
  el.style.color = el.dataset.color;
});

function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('active');
}
</script>
</body>
</html>