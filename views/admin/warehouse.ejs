<%- include('../partials/layout') %>

<div class="filters-row">
<h2 style="font-size:20px;font-weight:700"><i class="fas fa-boxes" style="color:var(--primary);margin-right:8px"></i>Склад</h2>
<button class="btn btn-primary" onclick="openModal('addPart')"><i class="fas fa-plus"></i> Новая запчасть</button>
</div>

<% if (criticalParts.length > 0) { %>
<div class="card" style="margin-bottom:20px;border:2px solid var(--danger)">
<div class="card-header" style="background:#fee2e2"><div class="card-title" style="color:#991b1b"><i class="fas fa-exclamation-triangle" style="margin-right:8px"></i>Критические остатки</div></div>
<div class="card-body" style="padding:0">
<table class="data-table">
<thead><tr><th>Артикул</th><th>Наименование</th><th>Производитель</th><th>Остаток</th><th>Мин.</th><th>Действия</th></tr></thead>
<tbody>
<% criticalParts.forEach(part => { %>
<tr>
<td><strong><%= part.article %></strong></td>
<td><%= part.name %></td>
<td><%= part.manufacturer %></td>
<td><span style="color:var(--danger);font-weight:700"><%= part.stock_main %> шт.</span></td>
<td><%= part.min_stock %> шт.</td>
<td><form method="POST" action="/admin/warehouse/parts/<%= part.id %>/restock" style="display:inline"><input type="hidden" name="quantity" value="<%= part.min_stock * 2 %>"><button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-shopping-cart"></i> Заказать</button></form></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
<% } %>

<div class="warehouse-grid">
<% parts.forEach(part => { %>
<div class="warehouse-card">
<div class="warehouse-card-header">
<div>
<div class="warehouse-card-title"><%= part.name %></div>
<div style="font-size:12px;color:var(--gray);margin-top:4px"><%= part.manufacturer %> | <%= part.category %></div>
</div>
<div class="warehouse-card-code"><%= part.article %></div>
</div>
<div class="stock-info">
<div><div class="stock-label">Основной склад</div><div class="stock-value <%= part.stock_main <= part.min_stock ? 'warning' : 'ok' %>"><%= part.stock_main %> шт.</div></div>
<div><div class="stock-label">Мин. остаток</div><div class="stock-value"><%= part.min_stock %> шт.</div></div>
</div>
<div class="stock-info" style="margin-top:8px">
<div><div class="stock-label">Закупка</div><div class="stock-value">₽<%= part.purchase_price.toLocaleString() %></div></div>
<div><div class="stock-label">Продажа</div><div class="stock-value" style="color:var(--primary)">₽<%= part.sale_price.toLocaleString() %></div></div>
</div>
<div style="margin-top:12px;display:flex;gap:8px">
<form method="POST" action="/admin/warehouse/parts/<%= part.id %>/restock" style="flex:1"><input type="hidden" name="quantity" value="10"><button type="submit" class="btn btn-outline btn-sm" style="width:100%"><i class="fas fa-plus"></i> +10</button></form>
</div>
</div>
<% }) %>
</div>

<div class="modal-overlay" id="addPartModal">
<div class="modal" style="max-width:500px">
<div class="modal-header"><div class="modal-title">Новая запчасть</div><button class="modal-close" onclick="closeModal('addPartModal')"><i class="fas fa-times"></i></button></div>
<div class="modal-body">
<form id="addPartForm" method="POST" action="/admin/warehouse/parts">
<div class="form-row">
<div class="form-group"><label class="form-label">Артикул *</label><input type="text" name="article" class="form-input" required></div>
<div class="form-group"><label class="form-label">Название *</label><input type="text" name="name" class="form-input" required></div>
</div>
<div class="form-row">
<div class="form-group"><label class="form-label">Производитель</label><input type="text" name="manufacturer" class="form-input"></div>
<div class="form-group"><label class="form-label">Категория *</label><select name="category" class="form-select" required>
<option value="Масла и жидкости">Масла и жидкости</option>
<option value="Тормозная система">Тормозная система</option>
<option value="Фильтры">Фильтры</option>
<option value="Ходовая часть">Ходовая часть</option>
<option value="Электрика">Электрика</option>
<option value="Кузов">Кузов</option>
</select></div>
</div>
<div class="form-row">
<div class="form-group"><label class="form-label">Остаток</label><input type="number" name="stock_main" class="form-input" value="0" min="0"></div>
<div class="form-group"><label class="form-label">Мин. остаток</label><input type="number" name="min_stock" class="form-input" value="5" min="0"></div>
</div>
<div class="form-row">
<div class="form-group"><label class="form-label">Закупка (₽)</label><input type="number" name="purchase_price" class="form-input" value="0" min="0"></div>
<div class="form-group"><label class="form-label">Продажа (₽)</label><input type="number" name="sale_price" class="form-input" value="0" min="0"></div>
</div>
</form>
</div>
<div class="modal-footer">
<button class="btn btn-outline" onclick="closeModal('addPartModal')">Отмена</button>
<button class="btn btn-primary" onclick="document.getElementById('addPartForm').submit()"><i class="fas fa-save"></i> Сохранить</button>
</div>
</div>
</div>

<script>
function openModal(id){document.getElementById(id+'Modal').classList.add('active');}
function closeModal(id){document.getElementById(id).classList.remove('active');}
document.querySelectorAll('.modal-overlay').forEach(m=>m.addEventListener('click',function(e){if(e.target===this)this.classList.remove('active');}));
</script>

</div>
</main>
</div>
<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('active');
}
</script>
</body>
</html>
