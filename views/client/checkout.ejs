<div class="card" style="max-width:800px">
  <div class="card-header">
    <div class="card-title">
      <i class="fas fa-credit-card" style="color:var(--primary);margin-right:8px"></i>Оформление заказа
    </div>
  </div>
  <div class="card-body">
    <% if (cartItems && cartItems.length > 0) { %>
    <form method="POST" action="/client/checkout">
      <div class="form-group">
        <label class="form-label">Выберите автомобиль *</label>
        <select name="car_id" class="form-select" required>
          <option value="">— Выберите авто —</option>
          <% if (cars && cars.length > 0) { %>
            <% cars.forEach(car => { %>
            <option value="<%= car.id %>"><%= car.brand %> <%= car.model %> (<%= car.license_plate || 'без номера' %>)</option>
            <% }) %>
          <% } %>
        </select>
        <% if (!cars || cars.length === 0) { %>
        <div style="margin-top:8px;font-size:13px;color:var(--danger)">
          <i class="fas fa-exclamation-circle"></i> <a href="/client/cars">Добавьте автомобиль</a> перед оформлением заказа
        </div>
        <% } %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Желаемая дата</label>
          <input type="date" name="appointment_date" class="form-input" min="<%= new Date().toISOString().split('T')[0] %>">
        </div>
        <div class="form-group">
          <label class="form-label">Желаемое время</label>
          <input type="time" name="appointment_time" class="form-input">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Комментарий</label>
        <textarea name="notes" class="form-textarea" placeholder="Опишите проблему или пожелания..."></textarea>
      </div>

      <div class="card" style="margin-bottom:20px;background:var(--gray-light)">
        <div class="card-body">
          <h3 style="font-size:16px;margin-bottom:12px">Состав заказа:</h3>
          <% cartItems.forEach(item => { %>
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--gray-border)">
            <span><%= item.service_name || item.part_name || '—' %> x<%= item.quantity || 1 %></span>
            <span>₽<%= (item.total || 0).toLocaleString() %></span>
          </div>
          <% }) %>
          <div style="display:flex;justify-content:space-between;padding:16px 0;font-size:20px;font-weight:700;border-top:2px solid var(--dark)">
            <span>ИТОГО:</span>
            <span style="color:var(--primary)">₽<%= (cartTotal && cartTotal.total ? cartTotal.total : 0).toLocaleString() %></span>
          </div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Способ оплаты</label>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <label style="display:flex;align-items:center;gap:8px;padding:12px 16px;border:1px solid var(--gray-border);border-radius:var(--radius-sm);cursor:pointer;flex:1">
            <input type="radio" name="payment_method" value="card" checked style="accent-color:var(--primary)">
            <i class="fas fa-credit-card" style="color:var(--primary)"></i> Картой онлайн
          </label>
          <label style="display:flex;align-items:center;gap:8px;padding:12px 16px;border:1px solid var(--gray-border);border-radius:var(--radius-sm);cursor:pointer;flex:1">
            <input type="radio" name="payment_method" value="cash" style="accent-color:var(--primary)">
            <i class="fas fa-money-bill-wave" style="color:var(--success)"></i> Наличными
          </label>
          <label style="display:flex;align-items:center;gap:8px;padding:12px 16px;border:1px solid var(--gray-border);border-radius:var(--radius-sm);cursor:pointer;flex:1">
            <input type="radio" name="payment_method" value="qr" style="accent-color:var(--primary)">
            <i class="fas fa-qrcode" style="color:var(--secondary)"></i> QR-код
          </label>
        </div>
      </div>

      <div style="display:flex;gap:12px;margin-top:24px">
        <a href="/client/cart" class="btn btn-outline" style="flex:1"><i class="fas fa-arrow-left"></i> Вернуться в корзину</a>
        <button type="submit" class="btn btn-primary" style="flex:2" <%= (!cars || cars.length === 0) ? 'disabled' : '' %>><i class="fas fa-check"></i> Подтвердить заказ</button>
      </div>
    </form>
    <% } else { %>
    <div class="empty-state">
      <i class="fas fa-shopping-cart"></i>
      <h3>Корзина пуста</h3>
      <p><a href="/client/services">Добавьте услуги в корзину</a></p>
    </div>
    <% } %>
  </div>
</div>