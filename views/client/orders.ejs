<%- include('../partials/client_layout') %>

<div class="filters-row">
<h2 style="font-size:20px;font-weight:700"><i class="fas fa-clipboard-list" style="color:var(--primary);margin-right:8px"></i>Мои заказ-наряды</h2>
<a href="/client/services" class="btn btn-primary"><i class="fas fa-plus"></i> Новый заказ</a>
</div>

<div class="card">
<div class="card-body" style="padding:0">
<% if (orders.length > 0) { %>
<table class="data-table">
<thead><tr><th>№</th><th>Дата</th><th>Автомобиль</th><th>Статус</th><th>Сумма</th><th>Оплачено</th><th>Действия</th></tr></thead>
<tbody>
<% orders.forEach(order => { %>
<tr>
<td><a href="/client/orders/<%= order.id %>" style="color:var(--primary);text-decoration:none;font-weight:600">#<%= order.order_number %></a></td>
<td><%= new Date(order.created_at).toLocaleDateString('ru-RU') %></td>
<td><%= order.brand ? order.brand + ' ' + order.model : '—' %></td>
<td>
<% if (order.status === 'created') { %><span class="status-badge status-created">Создан</span>
<% } else if (order.status === 'in_progress') { %><span class="status-badge status-work">В работе</span>
<% } else if (order.status === 'waiting_parts') { %><span class="status-badge status-wait">Ожидает запчастей</span>
<% } else if (order.status === 'ready') { %><span class="status-badge status-ready">Готов к выдаче</span>
<% } else if (order.status === 'completed') { %><span class="status-badge status-done">Выдан</span>
<% } else { %><span class="status-badge status-cancel">Отменён</span><% } %>
</td>
<td><span class="amount">₽<%= order.total_amount.toLocaleString() %></span></td>
<td><span class="amount" style="color:var(--success)">₽<%= order.paid_amount.toLocaleString() %></span></td>
<td><a href="/client/orders/<%= order.id %>" class="btn btn-outline btn-sm"><i class="fas fa-eye"></i></a></td>
</tr>
<% }) %>
</tbody>
</table>
<% } else { %>
<div class="empty-state"><i class="fas fa-clipboard-list"></i><h3>Нет заказов</h3><p><a href="/client/services">Закажите первую услугу</a></p></div>
<% } %>
</div>
</div>

</div>
</main>
</div>
<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('active');
}
</script>
</body>
</html>
