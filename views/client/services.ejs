<div class="page-header">
  <h1><i class="fas fa-wrench"></i> Услуги</h1>
</div>

<!-- БАННЕР АКЦИИ -->
<div style="background:linear-gradient(135deg,#667eea,#764ba2);border-radius:var(--radius);padding:20px 24px;margin-bottom:20px;color:#fff;display:flex;align-items:center;justify-content:space-between">
  <div>
    <div style="font-weight:700;font-size:18px;margin-bottom:4px">🎉 Акция месяца!</div>
    <div style="font-size:14px;opacity:0.9">Скидка 15% на комплексное ТО при записи онлайн</div>
  </div>
  <a href="/client/appointments" style="background:#fff;color:#667eea;padding:10px 20px;border-radius:var(--radius-sm);text-decoration:none;font-weight:600;font-size:14px">Записаться</a>
</div>

<!-- ФИЛЬТРЫ -->
<div class="filters-row">
  <input type="text" class="filter-input" id="searchInput" placeholder="🔍 Поиск по услуге..." onkeyup="filterServices(this.value)">
  <select class="filter-input" id="categoryFilter" onchange="filterByCategory(this.value)">
    <option value="all">📂 Все категории</option>
    <option value="ТО">🔧 ТО</option>
    <option value="Тормозная система">🛑 Тормозная система</option>
    <option value="Ходовая часть">⚙️ Ходовая часть</option>
    <option value="Двигатель">🏎️ Двигатель</option>
    <option value="Электрика">💡 Электрика</option>
    <option value="Диагностика">🔍 Диагностика</option>
    <option value="Трансмиссия">⚡ Трансмиссия</option>
    <option value="Кондиционер">❄️ Кондиционер</option>
    <option value="Выхлопная система">💨 Выхлопная система</option>
    <option value="Оптика">💡 Оптика</option>
    <option value="Стёкла">🪟 Стёкла</option>
    <option value="Рулевое управление">🎮 Рулевое управление</option>
    <option value="Антикор">🛡️ Антикор</option>
    <option value="Топливная система">⛽ Топливная система</option>
    <option value="Шиномонтаж">🛞 Шиномонтаж</option>
    <option value="Автомойки">🚿 Автомойки</option>
    <option value="Кузовной ремонт">🔨 Кузовной ремонт</option>
    <option value="Инфо">ℹ️ Инфо</option>
  </select>
  <button class="btn btn-outline" onclick="location.href='/client/cart'">
    <i class="fas fa-shopping-cart"></i> 
    Корзина (₽<%= (cartTotal && cartTotal.total) ? cartTotal.total.toLocaleString() : '0' %>)
  </button>
</div>

<!-- СЧЁТЧИК РЕЗУЛЬТАТОВ -->
<div style="margin-bottom:12px;font-size:13px;color:var(--gray)">
  <span id="resultsCount">Найдено <%= services.length %> услуг</span>
</div>

<div class="service-grid" id="servicesGrid">
  <% if (services && services.length > 0) { %>
    <% services.forEach(function(service) { %>
    <div class="service-card" data-category="<%= service.category %>" data-id="<%= service.id %>">
      <div style="position:absolute;top:12px;right:12px;z-index:10">
        <button onclick="toggleFavorite(<%= service.id %>)" style="background:none;border:none;cursor:pointer;font-size:18px;color:<%= service.is_favorite ? '#ef4444' : '#d1d5db' %>" id="fav-<%= service.id %>">
          <i class="fas fa-heart"></i>
        </button>
      </div>
      <div class="service-card-header">
        <div>
          <div class="service-card-title"><%= service.name %></div>
          <div style="font-size:12px;color:var(--gray);margin-top:4px">
            <span style="display:inline-block;background:var(--primary-light);color:var(--primary);padding:2px 8px;border-radius:10px;font-size:11px;font-weight:500"><%= service.category %></span>
          </div>
        </div>
        <div class="service-card-price">₽<%= ((service.labor_hours || 0) * (service.hourly_rate || 2500)).toLocaleString() %></div>
      </div>
      <div class="service-card-desc">
        <div style="margin-bottom:8px"><i class="fas fa-barcode" style="color:var(--gray);margin-right:6px"></i>Код: <%= service.code || '—' %></div>
        <div style="margin-bottom:8px"><i class="fas fa-clock" style="color:var(--gray);margin-right:6px"></i>Нормо-час: <%= service.labor_hours || 0 %> ч.</div>
        <div><i class="fas fa-car" style="color:var(--gray);margin-right:6px"></i><%= service.compatible_brands || 'Все марки' %></div>
      </div>
      <div class="service-card-footer">
        <div class="service-card-time"><i class="fas fa-hourglass-half"></i> ~<%= service.labor_hours || 0 %> часов</div>
        <div style="display:flex;gap:8px;">
          <button class="btn btn-outline btn-sm" onclick="openServiceModal(<%= service.id %>)">
            <i class="fas fa-info-circle"></i> Подробнее
          </button>
          <button class="btn btn-primary btn-sm" 
            onclick="addToCart(<%= service.id %>, '<%= service.name %>', <%= (service.labor_hours || 0) * (service.hourly_rate || 2500) %>)">
            <i class="fas fa-plus"></i> В корзину
          </button>
        </div>
      </div>
    </div>
    <% }) %>
  <% } else { %>
    <div class="empty-state" style="grid-column:1/-1">
      <i class="fas fa-wrench"></i>
      <h3>Нет услуг</h3>
      <p>Услуги появятся позже</p>
    </div>
  <% } %>
</div>

<!-- МОДАЛЬНОЕ ОКНО -->
<div id="serviceModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:200;justify-content:center;align-items:center;">
  <div style="background:#fff;border-radius:12px;max-width:500px;width:90%;max-height:80vh;overflow-y:auto;padding:24px;box-shadow:0 20px 40px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <h3 id="modalTitle" style="margin:0;font-size:18px;font-weight:600;">Детали услуги</h3>
      <button onclick="closeServiceModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#6b7280;">&times;</button>
    </div>
    <div id="modalBody"></div>
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;padding-top:16px;border-top:1px solid #e5e7eb;">
      <button class="btn btn-outline" onclick="closeServiceModal()">Закрыть</button>
      <button class="btn btn-primary" id="modalAddToCartBtn"><i class="fas fa-cart-plus"></i> В корзину</button>
      <button class="btn btn-success" id="modalBookBtn" onclick="location.href='/client/appointments'">
        <i class="fas fa-calendar-check"></i> Записаться
      </button>
    </div>
  </div>
</div>

<script>
var servicesData = {};
<% if (services && services.length > 0) { %>
  <% services.forEach(function(s) { %>
    servicesData[<%= s.id %>] = {
      id: <%= s.id %>,
      name: '<%= (s.name || '').replace(/'/g, "\\'") %>',
      category: '<%= (s.category || '').replace(/'/g, "\\'") %>',
      code: '<%= (s.code || '—').replace(/'/g, "\\'") %>',
      description: '<%= (s.description || 'Описание отсутствует').replace(/'/g, "\\'") %>',
      price: <%= (s.labor_hours || 0) * (s.hourly_rate || 2500) %>,
      labor_hours: <%= s.labor_hours || 0 %>,
      hourly_rate: <%= s.hourly_rate || 2500 %>,
      compatible_brands: '<%= (s.compatible_brands || 'Все марки').replace(/'/g, "\\'") %>'
    };
  <% }) %>
<% } %>

function openServiceModal(id) {
  var s = servicesData[id];
  if (!s) return;
  document.getElementById('modalTitle').textContent = s.name;
  document.getElementById('modalBody').innerHTML = 
    '<div style="margin-bottom:16px;"><span style="display:inline-block;background:#dbeafe;color:#1d4ed8;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:500;">' + s.category + '</span></div>' +
    '<div style="margin-bottom:16px;"><p style="color:#6b7280;font-size:14px;line-height:1.6;margin:0;">' + s.description + '</p></div>' +
    '<div style="background:#f9fafb;border-radius:8px;padding:16px;">' +
      '<div style="display:flex;justify-content:space-between;margin-bottom:8px;"><span style="color:#6b7280;font-size:13px;">Код услуги</span><span style="font-weight:500;font-size:13px;">' + s.code + '</span></div>' +
      '<div style="display:flex;justify-content:space-between;margin-bottom:8px;"><span style="color:#6b7280;font-size:13px;">Нормо-часы</span><span style="font-weight:500;font-size:13px;">' + s.labor_hours + ' ч.</span></div>' +
      '<div style="display:flex;justify-content:space-between;margin-bottom:8px;"><span style="color:#6b7280;font-size:13px;">Ставка за час</span><span style="font-weight:500;font-size:13px;">₽' + s.hourly_rate.toLocaleString() + '</span></div>' +
      '<div style="display:flex;justify-content:space-between;margin-bottom:8px;"><span style="color:#6b7280;font-size:13px;">Совместимые марки</span><span style="font-weight:500;font-size:13px;text-align:right;">' + s.compatible_brands + '</span></div>' +
      '<div style="border-top:1px solid #e5e7eb;margin-top:12px;padding-top:12px;display:flex;justify-content:space-between;align-items:center;"><span style="color:#6b7280;font-size:13px;">Итоговая стоимость</span><span style="font-weight:700;font-size:18px;color:#2563eb;">₽' + s.price.toLocaleString() + '</span></div>' +
    '</div>';
  document.getElementById('modalAddToCartBtn').onclick = function() {
    addToCart(s.id, s.name, s.price);
    closeServiceModal();
  };
  document.getElementById('serviceModal').style.display = 'flex';
}

function closeServiceModal() {
  document.getElementById('serviceModal').style.display = 'none';
}

function addToCart(id, name, price){
  fetch('/client/cart/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ service_id: id, quantity: 1, price: price })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if(data.success){
      showToast('success', '✅ "' + name + '" добавлена в корзину');
      setTimeout(function() { location.reload(); }, 1000);
    } else {
      showToast('error', '❌ ' + (data.message || 'Ошибка добавления'));
    }
  })
  .catch(function(e) {
    showToast('error', '❌ Ошибка: ' + e);
  });
}

function toggleFavorite(id) {
  var btn = document.getElementById('fav-' + id);
  var isFav = btn.style.color === 'rgb(239, 68, 68)';
  btn.style.color = isFav ? '#d1d5db' : '#ef4444';
  showToast('info', isFav ? '💔 Удалено из избранного' : '❤️ Добавлено в избранное');
}

function filterServices(query){
  var q = query.toLowerCase();
  var visible = 0;
  document.querySelectorAll('.service-card').forEach(function(card) {
    var show = card.textContent.toLowerCase().includes(q);
    card.style.display = show ? 'block' : 'none';
    if (show) visible++;
  });
  document.getElementById('resultsCount').textContent = 'Найдено ' + visible + ' услуг';
}

function filterByCategory(cat){
  var visible = 0;
  document.querySelectorAll('.service-card').forEach(function(card) {
    var show = cat === 'all' || card.dataset.category === cat;
    card.style.display = show ? 'block' : 'none';
    if (show) visible++;
  });
  document.getElementById('resultsCount').textContent = 'Найдено ' + visible + ' услуг';
}

function showToast(type, message) {
  var toast = document.createElement('div');
  toast.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:300;background:' + 
    (type === 'success' ? '#10b981' : type === 'error' ? '#ef4444' : '#3b82f6') + 
    ';color:white;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:500;box-shadow:0 10px 15px rgba(0,0,0,0.1);animation:slideIn 0.3s ease';
  toast.textContent = message;
  document.body.appendChild(toast);
  setTimeout(function() { toast.remove(); }, 3000);
}

document.getElementById('serviceModal').addEventListener('click', function(e) {
  if (e.target === this) closeServiceModal();
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeServiceModal();
});
</script>

<style>
@keyframes slideIn {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
</style>
