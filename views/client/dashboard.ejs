<h2 style="margin-bottom:20px">👋 Добро пожаловать, <%= user.full_name %>!</h2>

<!-- УВЕДОМЛЕНИЯ -->
<% if (notifications && notifications.filter(n => !n.is_read).length > 0) { %>
<div style="background:var(--primary-light);border:1px solid #bfdbfe;border-radius:var(--radius);padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:12px">
  <i class="fas fa-bell" style="color:var(--primary);font-size:20px"></i>
  <div style="flex:1">
    <div style="font-weight:600;font-size:14px;color:#1e40af">У вас <%= notifications.filter(n => !n.is_read).length %> новых уведомлений</div>
    <div style="font-size:12px;color:#3b82f6;margin-top:2px">Проверьте статус ваших заказов</div>
  </div>
  <a href="/client/notifications" style="background:var(--primary);color:#fff;padding:8px 16px;border-radius:var(--radius-sm);text-decoration:none;font-size:13px;font-weight:500">Посмотреть</a>
</div>
<% } %>

<!-- СТАТУС ТЕКУЩЕГО ЗАКАЗА -->
<% if (orders && orders.length > 0 && orders[0].status !== 'completed') { %>
<div class="card" style="margin-bottom:20px;border-left:4px solid var(--primary)">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-spinner fa-spin" style="color:var(--primary);margin-right:8px"></i>Активный заказ</div>
    <a href="/client/orders/<%= orders[0].id %>" class="btn btn-outline btn-sm">Подробнее</a>
  </div>
  <div class="card-body">
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px">
      <div style="width:60px;height:60px;border-radius:50%;background:var(--primary-light);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:24px">
        <i class="fas fa-car"></i>
      </div>
      <div>
        <div style="font-weight:600;font-size:16px">Заказ #<%= orders[0].order_number %></div>
        <div style="font-size:13px;color:var(--gray)"><%= orders[0].brand ? orders[0].brand + ' ' + orders[0].model : 'Автомобиль не указан' %></div>
      </div>
      <div style="margin-left:auto;text-align:right">
        <div style="font-size:24px;font-weight:700;color:var(--primary)">₽<%= (orders[0].total_amount || 0).toLocaleString() %></div>
        <div style="font-size:12px;color:var(--gray)"><%= orders[0].created_at ? new Date(orders[0].created_at).toLocaleDateString('ru-RU') : '' %></div>
      </div>
    </div>
    <!-- Прогресс-бар статуса -->
    <div style="display:flex;gap:4px;margin-bottom:8px">
      <div style="flex:1;height:8px;background:<%= ['created','in_progress','waiting_parts','ready','completed'].indexOf(orders[0].status) >= 0 ? 'var(--primary)' : '#e5e7eb' %>;border-radius:4px"></div>
      <div style="flex:1;height:8px;background:<%= ['in_progress','waiting_parts','ready','completed'].indexOf(orders[0].status) >= 0 ? 'var(--primary)' : '#e5e7eb' %>;border-radius:4px"></div>
      <div style="flex:1;height:8px;background:<%= ['waiting_parts','ready','completed'].indexOf(orders[0].status) >= 0 ? 'var(--primary)' : '#e5e7eb' %>;border-radius:4px"></div>
      <div style="flex:1;height:8px;background:<%= ['ready','completed'].indexOf(orders[0].status) >= 0 ? 'var(--primary)' : '#e5e7eb' %>;border-radius:4px"></div>
      <div style="flex:1;height:8px;background:<%= orders[0].status === 'completed' ? 'var(--success)' : '#e5e7eb' %>;border-radius:4px"></div>
    </div>
    <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--gray)">
      <span>Создан</span><span>В работе</span><span>Ожидание</span><span>Готов</span><span>Выдан</span>
    </div>
  </div>
</div>
<% } %>

<!-- МОИ АВТОМОБИЛИ -->
<div class="card">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-car" style="color:var(--primary);margin-right:8px"></i>Мои автомобили</div>
    <a href="/client/cars" class="btn btn-outline btn-sm">Управлять</a>
  </div>
  <div class="card-body">
    <% if (cars && cars.length > 0) { %>
      <div style="display:flex;gap:16px;flex-wrap:wrap">
        <% cars.forEach(car => { %>
        <div style="background:var(--gray-light);padding:16px;border-radius:var(--radius);min-width:220px;flex:1;position:relative">
          <div style="position:absolute;top:12px;right:12px;width:32px;height:32px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px">
            <i class="fas fa-car"></i>
          </div>
          <div style="font-weight:600;font-size:16px"><%= car.brand %> <%= car.model %></div>
          <div style="font-size:13px;color:var(--gray);margin-top:4px"><%= car.license_plate || '—' %></div>
          <div style="font-size:12px;color:var(--gray);margin-top:2px"><%= car.year || '' %> • <%= car.mileage ? car.mileage.toLocaleString() + ' км' : '' %></div>
          <div style="margin-top:12px;display:flex;gap:8px">
            <a href="/client/services" class="btn btn-primary btn-sm"><i class="fas fa-wrench"></i> Записаться</a>
            <a href="/client/orders" class="btn btn-outline btn-sm"><i class="fas fa-history"></i> История</a>
          </div>
        </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-car"></i>
        <h3>Нет автомобилей</h3>
        <p><a href="/client/cars" style="color:var(--primary)">Добавить первый автомобиль</a></p>
      </div>
    <% } %>
  </div>
</div>

<!-- ПОСЛЕДНИЕ ЗАКАЗЫ -->
<div class="card">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-clipboard-list" style="color:var(--primary);margin-right:8px"></i>Последние заказы</div>
    <a href="/client/orders" class="btn btn-outline btn-sm">Все заказы</a>
  </div>
  <div class="card-body" style="padding:0">
    <table class="data-table">
      <thead>
        <tr><th>№</th><th>Дата</th><th>Услуги</th><th>Статус</th><th>Сумма</th><th></th></tr>
      </thead>
      <tbody>
        <% if (orders && orders.length > 0) { %>
          <% orders.slice(0, 3).forEach(order => { %>
          <tr>
            <td><a href="/client/orders/<%= order.id %>" style="color:var(--primary);text-decoration:none;font-weight:600">#<%= order.order_number %></a></td>
            <td><%= order.created_at ? new Date(order.created_at).toLocaleDateString('ru-RU') : '—' %></td>
            <td><%= order.description || '—' %></td>
            <td>
              <% if (order.status === 'created') { %><span class="badge badge-info">Создан</span>
              <% } else if (order.status === 'in_progress') { %><span class="badge badge-warning">В работе</span>
              <% } else if (order.status === 'ready') { %><span class="badge badge-success">Готов</span>
              <% } else if (order.status === 'completed') { %><span class="badge">Выдан</span>
              <% } else { %><span class="badge badge-danger">Отменён</span><% } %>
            </td>
            <td><strong>₽<%= (order.total_amount || 0).toLocaleString() %></strong></td>
            <td><a href="/client/orders/<%= order.id %>" class="btn btn-outline btn-sm"><i class="fas fa-eye"></i></a></td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" style="text-align:center;padding:24px;color:var(--gray)">Нет заказов</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- БЫСТРЫЕ ДЕЙСТВИЯ -->
<div class="card">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-bolt" style="color:var(--secondary);margin-right:8px"></i>Быстрые действия</div>
  </div>
  <div class="card-body">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
      <a href="/client/services" style="background:var(--primary);color:#fff;padding:16px;border-radius:var(--radius);text-align:center;text-decoration:none;transition:all .2s">
        <i class="fas fa-wrench" style="font-size:24px;margin-bottom:8px;display:block"></i>
        <span style="font-size:14px;font-weight:600">Записаться на сервис</span>
      </a>
      <a href="/client/appointments" style="background:var(--success);color:#fff;padding:16px;border-radius:var(--radius);text-align:center;text-decoration:none;transition:all .2s">
        <i class="fas fa-calendar" style="font-size:24px;margin-bottom:8px;display:block"></i>
        <span style="font-size:14px;font-weight:600">Мои записи</span>
      </a>
      <a href="/client/invoices" style="background:var(--secondary);color:#fff;padding:16px;border-radius:var(--radius);text-align:center;text-decoration:none;transition:all .2s">
        <i class="fas fa-file-invoice" style="font-size:24px;margin-bottom:8px;display:block"></i>
        <span style="font-size:14px;font-weight:600">Оплатить счёт</span>
      </a>
    </div>
  </div>
</div>

<!-- QR-КОД ДЛЯ БЫСТРОГО ДОСТУПА -->
<div class="card">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-qrcode" style="color:var(--primary);margin-right:8px"></i>Быстрый доступ</div>
  </div>
  <div class="card-body">
    <div style="display:flex;align-items:center;gap:20px">
      <div style="width:120px;height:120px;background:var(--gray-light);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;border:2px dashed var(--gray-border)">
        <i class="fas fa-qrcode" style="font-size:48px;color:var(--gray)"></i>
      </div>
      <div>
        <div style="font-weight:600;margin-bottom:8px">QR-код для быстрого доступа</div>
        <div style="font-size:13px;color:var(--gray);margin-bottom:12px">Отсканируйте код на телефоне, чтобы быстро открыть личный кабинет</div>
        <button class="btn btn-outline btn-sm" onclick="alert('QR-код будет сгенерирован при деплое на хостинг')">
          <i class="fas fa-download"></i> Скачать QR-код
        </button>
      </div>
    </div>
  </div>
</div>
