<div class="page-header">
  <h1><i class="fas fa-cogs"></i> Запчасти и аксессуары</h1>
  <div class="header-actions">
    <a href="/client/services" class="btn btn-outline">
      <i class="fas fa-wrench"></i> Услуги
    </a>
    <a href="/client/cart" class="btn btn-primary">
      <i class="fas fa-shopping-cart"></i> Корзина (₽<%= (cartTotal && cartTotal.total) ? cartTotal.total.toLocaleString() : '0' %>)
    </a>
  </div>
</div>

<!-- ФИЛЬТРЫ -->
<div class="filters-row">
  <div class="search-box">
    <i class="fas fa-search"></i>
    <input type="text" class="filter-input" id="searchInput" placeholder="Поиск по названию или артикулу..." onkeyup="filterParts(this.value)">
  </div>
  <select class="filter-input" id="categoryFilter" onchange="filterByCategory(this.value)">
    <option value="all">📂 Все категории</option>
    <option value="Масла и жидкости">🛢️ Масла и жидкости</option>
    <option value="Фильтры">🔧 Фильтры</option>
    <option value="Тормозная система">🛑 Тормозная система</option>
    <option value="Двигатель">🏎️ Двигатель</option>
    <option value="Электрика">💡 Электрика</option>
    <option value="Ходовая часть">⚙️ Ходовая часть</option>
    <option value="Рулевое управление">🎮 Рулевое управление</option>
    <option value="Кондиционер">❄️ Кондиционер</option>
    <option value="Выхлопная система">💨 Выхлопная система</option>
    <option value="Оптика">💡 Оптика</option>
    <option value="Стёкла">🪟 Стёкла</option>
    <option value="Трансмиссия">⚡ Трансмиссия</option>
    <option value="Топливная система">⛽ Топливная система</option>
    <option value="Шины">🛞 Шины</option>
    <option value="Автокосметика">✨ Автокосметика</option>
    <option value="Аксессуары">🎁 Аксессуары</option>
    <option value="Электроника">📱 Электроника</option>
  </select>
</div>

<!-- КАТЕГОРИИ-ЧИПЫ -->
<div class="category-chips" id="categoryChips">
  <button class="chip active" data-category="all" onclick="filterByCategory('all')">
    <span>📂</span> Все
  </button>
  <% if (categories && categories.length > 0) { %>
    <% categories.forEach(function(cat) { %>
      <% var icons = {
        'Масла и жидкости': '🛢️', 'Фильтры': '🔧', 'Тормозная система': '🛑', 'Двигатель': '🏎️',
        'Электрика': '💡', 'Ходовая часть': '⚙️', 'Рулевое управление': '🎮', 'Кондиционер': '❄️',
        'Выхлопная система': '💨', 'Оптика': '💡', 'Стёкла': '🪟', 'Трансмиссия': '⚡',
        'Топливная система': '⛽', 'Шины': '🛞', 'Автокосметика': '✨', 'Аксессуары': '🎁', 'Электроника': '📱'
      }; %>
      <button class="chip" data-category="<%= cat %>" onclick="filterByCategory('<%= cat %>')">
        <span><%= icons[cat] || '📦' %></span> <%= cat %>
      </button>
    <% }) %>
  <% } %>
</div>

<!-- СЧЁТЧИК -->
<div class="results-count">
  <span id="resultsCount">Найдено <%= parts.length %> товаров</span>
</div>

<!-- СЕТКА ТОВАРОВ -->
<div class="parts-grid" id="partsGrid">
  <% if (parts && parts.length > 0) { %>
    <% parts.forEach(function(part) { %>
    <div class="part-card" data-category="<%= part.category %>" data-id="<%= part.id %>">
      <div class="part-image">
        <div class="part-image-placeholder">
          <i class="fas fa-cog"></i>
        </div>
        <% if (part.stock_main <= part.min_stock) { %>
          <span class="stock-badge low">Мало</span>
        <% } else { %>
          <span class="stock-badge ok">В наличии</span>
        <% } %>
        <% if (part.popularity >= 80) { %>
          <span class="popular-badge"><i class="fas fa-fire"></i> Хит</span>
        <% } %>
      </div>
      <div class="part-body">
        <div class="part-category"><%= part.category || 'Другое' %></div>
        <div class="part-name" title="<%= part.name %>"><%= part.name %></div>
        <div class="part-article">Артикул: <%= part.article %></div>
        <div class="part-manufacturer"><i class="fas fa-industry"></i> <%= part.manufacturer || '—' %></div>
        <div class="part-stock">
          <div class="stock-bar">
            <div class="stock-fill" style="width:<%= Math.min((part.stock_main / (part.min_stock * 3)) * 100, 100) %>"></div>
          </div>
          <span class="stock-count"><%= part.stock_main %> шт.</span>
        </div>
        <div class="part-popularity">
          <div class="pop-bar"><div class="pop-fill" style="width:<%= part.popularity || 0 %>"></div></div>
          <span class="pop-label"><%= part.popularity || 0 %>%</span>
        </div>
      </div>
      <div class="part-footer">
        <div class="part-price">
          <span class="price-current">₽<%= part.sale_price.toLocaleString() %></span>
          <% if (part.purchase_price < part.sale_price) { %>
            <span class="price-old">₽<%= Math.round(part.sale_price * 1.2).toLocaleString() %></span>
          <% } %>
        </div>
        <button class="btn btn-primary btn-sm" onclick="addPartToCart(<%= part.id %>, <%= JSON.stringify(part.name) %>, <%= part.sale_price %>)">
          <i class="fas fa-cart-plus"></i>
        </button>
      </div>
    </div>
    <% }) %>
  <% } else { %>
    <div class="empty-state" style="grid-column:1/-1">
      <i class="fas fa-cogs"></i>
      <h3>Нет товаров</h3>
      <p>Каталог заполняется</p>
    </div>
  <% } %>
</div>

<script>
function filterParts(query) {
  var q = query.toLowerCase().trim();
  var visible = 0;
  document.querySelectorAll('.part-card').forEach(function(card) {
    var text = card.textContent.toLowerCase();
    var show = q === '' || text.includes(q);
    card.style.display = show ? 'flex' : 'none';
    if (show) visible++;
  });
  document.getElementById('resultsCount').textContent = 'Найдено ' + visible + ' товаров';
  updateChipActive();
}

function filterByCategory(cat) {
  var visible = 0;
  document.querySelectorAll('.part-card').forEach(function(card) {
    var show = cat === 'all' || card.dataset.category === cat;
    card.style.display = show ? 'flex' : 'none';
    if (show) visible++;
  });
  document.getElementById('resultsCount').textContent = 'Найдено ' + visible + ' товаров';
  document.getElementById('categoryFilter').value = cat;
  updateChipActive();
}

function updateChipActive() {
  var currentCat = document.getElementById('categoryFilter').value;
  document.querySelectorAll('.chip').forEach(function(chip) {
    if (chip.dataset.category === currentCat) {
      chip.classList.add('active');
    } else {
      chip.classList.remove('active');
    }
  });
}

function addPartToCart(id, name, price) {
  fetch('/client/cart/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ part_id: id, quantity: 1, price: price })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if(data.success){
      showToast('success', '✅ "' + name + '" добавлен в корзину');
      setTimeout(function() { location.reload(); }, 1000);
    } else {
      showToast('error', '❌ ' + (data.message || 'Ошибка добавления'));
    }
  })
  .catch(function(e) {
    showToast('error', '❌ Ошибка: ' + e);
  });
}

function showToast(type, message) {
  var toast = document.createElement('div');
  toast.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:300;background:' +
    (type === 'success' ? '#10b981' : type === 'error' ? '#ef4444' : '#3b82f6') +
    ';color:white;padding:12px 20px;border-radius:8px;font-size:14px;font-weight:500;box-shadow:0 10px 15px rgba(0,0,0,0.1);animation:slideIn 0.3s ease';
  toast.textContent = message;
  document.body.appendChild(toast);
  setTimeout(function() { toast.remove(); }, 3000);
}

updateChipActive();
</script>

<style>
@keyframes slideIn {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

.page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px}
.page-header h1{font-size:24px;font-weight:700;display:flex;align-items:center;gap:12px}
.header-actions{display:flex;gap:10px;flex-wrap:wrap}

.search-box{position:relative;flex:1;min-width:250px;max-width:400px}
.search-box i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gray);font-size:14px}
.search-box .filter-input{padding-left:36px;width:100%}

.category-chips{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.chip{padding:6px 14px;border-radius:20px;border:1px solid var(--gray-border);background:var(--white);font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;color:var(--gray);display:flex;align-items:center;gap:6px}
.chip:hover{background:var(--gray-light);border-color:var(--gray)}
.chip.active{background:var(--primary);color:#fff;border-color:var(--primary)}
.chip.active span{filter:brightness(2)}

.results-count{margin-bottom:16px;font-size:13px;color:var(--gray)}

.parts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
.part-card{
  background:var(--white);border:1px solid var(--gray-border);border-radius:var(--radius);overflow:hidden;
  transition:all .3s;display:flex;flex-direction:column;transform-style:preserve-3d;perspective:1000px;
}
.part-card:hover{box-shadow:0 20px 40px rgba(0,0,0,0.1);transform:translateY(-4px) rotateX(2deg);border-color:var(--primary)}
.part-image{position:relative;height:160px;background:linear-gradient(135deg,#f1f5f9,#e2e8f0);display:flex;align-items:center;justify-content:center}
.part-image-placeholder{width:80px;height:80px;border-radius:50%;background:var(--white);display:flex;align-items:center;justify-content:center;color:var(--gray);font-size:32px;box-shadow:var(--shadow);animation:float 3s ease-in-out infinite}
.stock-badge{position:absolute;top:8px;right:8px;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:600}
.stock-badge.ok{background:#d1fae5;color:#065f46}
.stock-badge.low{background:#fef3c7;color:#92400e}
.popular-badge{position:absolute;top:8px;left:8px;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:600;background:linear-gradient(135deg,#ef4444,#f59e0b);color:white;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.7}}
.part-body{padding:14px 16px;flex:1}
.part-category{font-size:11px;color:var(--gray);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;font-weight:500}
.part-name{font-size:14px;font-weight:600;color:var(--dark);margin-bottom:6px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.part-article{font-size:12px;color:var(--gray);margin-bottom:4px}
.part-manufacturer{font-size:12px;color:var(--gray);margin-bottom:10px;display:flex;align-items:center;gap:4px}
.part-stock{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.stock-bar{flex:1;height:6px;background:#e2e8f0;border-radius:3px;overflow:hidden}
.stock-fill{height:100%;background:var(--success);border-radius:3px;transition:width .3s}
.stock-count{font-size:11px;color:var(--gray);white-space:nowrap}
.part-popularity{display:flex;align-items:center;gap:8px}
.part-popularity .pop-bar{flex:1;height:3px;background:#e2e8f0;border-radius:2px;overflow:hidden}
.part-popularity .pop-fill{height:100%;background:linear-gradient(90deg,#f59e0b,#ef4444);border-radius:2px}
.part-popularity .pop-label{font-size:10px;color:var(--gray)}
.part-footer{padding:12px 16px;border-top:1px solid var(--gray-border);display:flex;justify-content:space-between;align-items:center}
.part-price{display:flex;align-items:center;gap:8px;flex-direction:column;align-items:flex-start}
.price-current{font-size:18px;font-weight:700;color:var(--primary)}
.price-old{font-size:13px;color:var(--gray);text-decoration:line-through}

@media(max-width:768px){
  .parts-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:480px){
  .parts-grid{grid-template-columns:1fr}
}
</style>
