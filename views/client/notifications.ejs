<%- include('../partials/client_layout') %>

<div class="filters-row">
  <h2 style="font-size:20px;font-weight:700"><i class="fas fa-bell" style="color:var(--primary);margin-right:8px"></i>Уведомления</h2>
</div>

<div class="card">
  <div class="card-body">
    <% if (notifications.length > 0) { %>
      <div class="activity-list">
        <% notifications.forEach(notif => { %>
          <%
            let iconBg;
            let iconClass;
            if (notif.type === 'order') {
              iconBg = '#dbeafe';
              iconClass = 'clipboard-list';
            } else if (notif.type === 'invoice') {
              iconBg = '#fef3c7';
              iconClass = 'file-invoice';
            } else if (notif.type === 'appointment') {
              iconBg = '#d1fae5';
              iconClass = 'calendar-check';
            } else {
              iconBg = '#e5e7eb';
              iconClass = 'bell';
            }
          %>
          <div class="activity-item">
            <div class="activity-icon" data-bg="<%= iconBg %>">
              <i class="fas fa-<%= iconClass %>"></i>
            </div>
            <div class="activity-content">
              <div class="activity-text"><strong><%= notif.title %></strong></div>
              <div class="activity-text"><%= notif.message %></div>
              <div class="activity-time"><%= new Date(notif.created_at).toLocaleString('ru-RU') %></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state"><i class="fas fa-bell"></i><h3>Нет уведомлений</h3><p>Здесь будут появляться уведомления о ваших заказах и записи.</p></div>
    <% } %>
  </div>
</div>

</div>
</main>

<script>
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('active');
}
</script>
</body>
</html>